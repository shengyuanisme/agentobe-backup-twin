HOST=127.0.0.1
PORT=4100
DATABASE_URL=postgres://agentobe:agentobe-local@127.0.0.1:54329/agentobe
PROJECTION_TOKEN_KEY=replace-this-in-non-demo-environments
LOG_LEVEL=info
CONSOLE_ORIGINS=http://localhost:4173,http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/agentobe
OIDC_AUDIENCE=agentobe-api
# Optional when provider discovery is available
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
# One-time, idempotent first owner provisioning
AUTH_BOOTSTRAP_ORGANIZATION_ID=00000000-0000-4000-8000-000000000010
AUTH_BOOTSTRAP_SUBJECT=
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_DISPLAY_NAME=
VAULT_DRIVER=file
VAULT_FILE_DIR=/tmp/agentobe-vault
# Generate with: openssl rand -base64 32
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=v1
# Required when VAULT_DRIVER=spaces
SPACES_BUCKET=
SPACES_REGION=sfo3
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_WEBHOOK_URL=
